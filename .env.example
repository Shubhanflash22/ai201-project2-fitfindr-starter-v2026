# Copy this file to .env and paste your key in.
#
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env
#
# .env is listed in .gitignore, so it never reaches GitHub. Never paste the key
# into code, the README, a screenshot, or a message. If it is exposed, delete it
# and make a new one; keys are free to replace.
#
# Get a key at https://aistudio.google.com: sign in with a Google account,
# create your own project when prompted, and make a key inside it.

GEMINI_API_KEY=your_key_here

# ─── Optional ────────────────────────────────────────────────────────────────

# Turn the response cache off entirely (run_eval.py already does this).
# AI201_CACHE=0
